# Copy to .env. Everything else (calendars, colours, timezone, weather location)
# is set in the web settings page at /settings and stored in DATA_DIR/kalends.db.

# Port the web server listens on.
PORT=3000

# Address to bind. 0.0.0.0 = all interfaces.
HOST=0.0.0.0

# Where the SQLite database and the optional photos/ folder live.
DATA_DIR=./data
